/*
 * Keybinding manual (Super + /). Rows come from hypr/lua/lib/manual.lua:
 * bold keys, a dimmer description, one row per action.
 * Colours follow the wallpaper through Wallust's rofi palette.
 */

@import "~/.config/rofi/colors/wallust.rasi"

configuration {
    show-icons: false;
}

* {
    font: "CaskaydiaCove Nerd Font 11";
    background-color: transparent;
    text-color: @foreground;
    surface: @foreground-10;
    selection: @primary-40;
}

window {
    location: center;
    anchor: center;
    width: 860px;
    padding: 18px;
    border: 1px;
    border-color: @primary-50;
    border-radius: 12px;
    background-color: @background;
}

mainbox {
    spacing: 14px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 10px 14px;
    spacing: 12px;
    border-radius: 10px;
    background-color: @surface;
    children: [ "icon-search", "entry", "num-filtered-rows", "textbox-of", "num-rows" ];
}

icon-search {
    expand: false;
    filename: "search";
    size: 1.1em;
    vertical-align: 0.5;
}

entry {
    vertical-align: 0.5;
    placeholder: "Search keys or actions · Enter or Esc closes";
    placeholder-color: @foreground-50;
    cursor: text;
}

num-filtered-rows, num-rows, textbox-of {
    expand: false;
    vertical-align: 0.5;
    text-color: @foreground-50;
}

textbox-of {
    str: "/";
}

listview {
    lines: 14;
    columns: 1;
    spacing: 2px;
    fixed-height: true;
    scrollbar: false;
    cycle: true;
}

element {
    padding: 8px 14px;
    border-radius: 8px;
}

element selected.normal {
    background-color: @selection;
}

element-text {
    vertical-align: 0.5;
    highlight: underline;
}

error-message {
    padding: 14px;
    background-color: @background;
}
