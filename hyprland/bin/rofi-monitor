#!/usr/bin/env bash

# ╔══════════════════════════════════════════════════╗
# ║  rofi-monitor - Monitor Refresh Rate & VRR Menu  ║
# ╚══════════════════════════════════════════════════╝
#
# Quickly switch refresh rates and toggle VRR (Variable Refresh Rate)
# via a rofi menu. Uses hyprctl for live changes.

# ── Configuration ──────────────────────────────────
NOTIFY_CMD="dunstify"
NOTIFY_TIMEOUT=3000
APP_NAME="Monitor"
ICON_MONITOR="display"
ICON_VRR="monitor"

# Preferred refresh rates to show (at native resolution only)
# Leave empty to auto-detect all available rates
PREFERRED_RATES=(180 144 120 60)

# ── Rofi Theme ─────────────────────────────────────
ROFI_THEME="$HOME/.config/rofi/applets/type-1/style-1.rasi"

# ── Functions ──────────────────────────────────────

notify() {
    local msg="$1"
    local urgency="${2:-normal}"
    $NOTIFY_CMD -a "$APP_NAME" -u "$urgency" -t "$NOTIFY_TIMEOUT" \
        -i "$ICON_MONITOR" "$APP_NAME" "$msg" -r 9999
}

get_monitor_info() {
    hyprctl monitors -j | jq -r '.[0]'
}

get_monitor_name() {
    echo "$MONITOR_JSON" | jq -r '.name'
}

get_current_rate() {
    echo "$MONITOR_JSON" | jq -r '.refreshRate | floor'
}

get_resolution() {
    local w h
    w=$(echo "$MONITOR_JSON" | jq -r '.width')
    h=$(echo "$MONITOR_JSON" | jq -r '.height')
    echo "${w}x${h}"
}

get_scale() {
    echo "$MONITOR_JSON" | jq -r '.scale'
}

get_vrr_status() {
    echo "$MONITOR_JSON" | jq -r '.vrr'
}

get_available_rates() {
    local resolution="$1"
    echo "$MONITOR_JSON" | jq -r --arg res "$resolution" '
        .availableModes[]
        | select(startswith($res + "@"))
        | split("@")[1]
        | rtrimstr("Hz")
        | tonumber | floor
    ' | sort -rn | uniq
}

get_position() {
    local x y
    x=$(echo "$MONITOR_JSON" | jq -r '.x')
    y=$(echo "$MONITOR_JSON" | jq -r '.y')
    echo "${x}x${y}"
}

set_refresh_rate() {
    local rate="$1"
    local monitor resolution scale position
    monitor=$(get_monitor_name)
    resolution=$(get_resolution)
    scale=$(get_scale)
    position=$(get_position)

    hyprctl keyword monitor "${monitor},${resolution}@${rate},${position},${scale}"

    if [[ $? -eq 0 ]]; then
        notify "Switched to ${rate}Hz"
    else
        notify "Failed to switch to ${rate}Hz" "critical"
    fi
}

toggle_vrr() {
    local current_vrr
    current_vrr=$(get_vrr_status)

    if [[ "$current_vrr" == "true" ]]; then
        hyprctl keyword misc:vrr 0
        notify "VRR Disabled"
    else
        hyprctl keyword misc:vrr 1
        notify "VRR Enabled (Adaptive Sync)"
    fi
}

build_menu() {
    local current_rate resolution available_rates vrr_status
    current_rate=$(get_current_rate)
    resolution=$(get_resolution)
    vrr_status=$(get_vrr_status)

    # Get available rates at current resolution
    local all_rates
    all_rates=$(get_available_rates "$resolution")

    # Filter to preferred rates if set, otherwise use all
    local rates=()
    if [[ ${#PREFERRED_RATES[@]} -gt 0 ]]; then
        for rate in "${PREFERRED_RATES[@]}"; do
            if echo "$all_rates" | grep -qx "$rate"; then
                rates+=("$rate")
            fi
        done
    else
        while IFS= read -r rate; do
            rates+=("$rate")
        done <<< "$all_rates"
    fi

    # Build menu entries
    for rate in "${rates[@]}"; do
        if [[ "$rate" -eq "$current_rate" ]]; then
            echo "  ${rate}Hz  ●"
        else
            echo "  ${rate}Hz"
        fi
    done

    # VRR toggle
    echo ""
    if [[ "$vrr_status" == "true" ]]; then
        echo "  VRR  ON"
    else
        echo "  VRR  OFF"
    fi
}

run_rofi() {
    local current_rate resolution monitor_name vrr_status
    current_rate=$(get_current_rate)
    resolution=$(get_resolution)
    monitor_name=$(get_monitor_name)
    vrr_status=$(get_vrr_status)

    local vrr_label="OFF"
    [[ "$vrr_status" == "true" ]] && vrr_label="ON"

    local mesg="${monitor_name} · ${resolution} · ${current_rate}Hz · VRR: ${vrr_label}"

    local row_count
    row_count=$(build_menu | wc -l)

    build_menu | rofi \
        -theme "${ROFI_THEME}" \
        -theme-str "window {width: 400px;}" \
        -theme-str "listview {columns: 1; lines: ${row_count};}" \
        -theme-str 'textbox-prompt-colon {str: "󰍹";}' \
        -dmenu \
        -p "Monitor" \
        -mesg "$mesg" \
        -markup-rows \
        -selected-row 0
}

# ── Main ───────────────────────────────────────────

# Cache monitor info
MONITOR_JSON=$(get_monitor_info)

if [[ -z "$MONITOR_JSON" || "$MONITOR_JSON" == "null" ]]; then
    notify "Could not get monitor info" "critical"
    exit 1
fi

chosen="$(run_rofi)"
[[ -z "$chosen" ]] && exit 0

# Strip whitespace and markers
chosen=$(echo "$chosen" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')

case "$chosen" in
    *"VRR"*)
        toggle_vrr
        ;;
    *"Hz"*)
        # Extract the rate number
        rate=$(echo "$chosen" | grep -oP '\d+(?=Hz)')
        if [[ -n "$rate" ]]; then
            set_refresh_rate "$rate"
        fi
        ;;
esac
