#!/usr/bin/env bash

# ==============================================================================
# CONFIGURATION
# ==============================================================================

VERSION="2.0"

show_help() {
    cat << EOF
VPN Manager - WireGuard Connection Manager

USAGE:
    rofi-vpn [CONNECTION_NAME] [OPTIONS]

ARGUMENTS:
    CONNECTION_NAME    Optional. Name of VPN connection to connect/toggle.
                      If provided, skips Rofi menu and directly connects/toggles.

OPTIONS:
    -h, --help        Show this help message and exit
    -v, --version     Show version information and exit

EXAMPLES:
    rofi-vpn                    # Open Rofi menu to select VPN
    rofi-vpn US-VPN             # Connect/toggle US-VPN directly
    rofi-vpn --help             # Show help message

NOTES:
    - If CONNECTION_NAME matches the active VPN, it will disconnect
    - If CONNECTION_NAME is different, it will connect (disconnecting active VPN first)
    - Notifications are sent for all actions (if dunstify is available)
EOF
}

# Parse CLI arguments
DIRECT_CONNECTION=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)    show_help; exit 0 ;;
        -v|--version) echo "rofi-vpn version $VERSION"; exit 0 ;;
        -*)           echo "Unknown option: $1" >&2; echo "Use --help for usage information." >&2; exit 1 ;;
        *)            [ -z "$DIRECT_CONNECTION" ] && DIRECT_CONNECTION="$1"; shift ;;
    esac
done

ROFI_THEME="$HOME/.config/rofi/launchers/type-2/style-1.rasi"
ICON_CONNECTED="security-high"
ICON_DISCONNECTED="network-vpn"
VPN_CONNECTED_ICON=""
VPN_DISCONNECTED_ICON=""
USE_EMOJI_FLAGS=true
FLAG_DIR=""
FLAG_URL_BASE="https://flagcdn.com/w80/"
FLAG_CACHE_DIR="$HOME/.cache/rofi-vpn/flags"
NOTIF_ID=992022

# ==============================================================================
# FUNCTIONS
# ==============================================================================

# Extract 2-letter country code from a VPN name
extract_country_code() {
    local name="$1"
    [ -z "$name" ] && return 1
    local patterns=(
        '^([A-Z]{2})([-_]|$)'
        '[-_]([A-Z]{2})([-_]|$)'
        '([A-Z]{2})'
        '^([a-z]{2})([-_]|$)'
        '[-_]([a-z]{2})([-_]|$)'
        '([a-z]{2})'
    )
    for pat in "${patterns[@]}"; do
        if [[ "$name" =~ $pat ]]; then
            echo "${BASH_REMATCH[1]^^}"
            return 0
        fi
    done
    return 1
}

# Convert 2-letter country code to Unicode emoji flag
country_code_to_flag_emoji() {
    local code="${1^^}"
    [[ ${#code} -ne 2 || ! "$code" =~ ^[A-Z]{2}$ ]] && return 1
    local a=$(printf '%d' "'${code:0:1}") b=$(printf '%d' "'${code:1:1}")
    [[ $a -lt 65 || $a -gt 90 || $b -lt 65 || $b -gt 90 ]] && return 1
    printf "\\U%08X\\U%08X" $((0x1F1E6 + a - 65)) $((0x1F1E6 + b - 65)) 2>/dev/null
}

# Get cached flag path, optionally trigger async download if missing
# Usage: get_cached_flag COUNTRY_CODE [trigger_async=false]
get_cached_flag() {
    local code="${1,,}" trigger="${2:-false}"
    [ -z "$FLAG_URL_BASE" ] && return 1

    local cache_file="$FLAG_CACHE_DIR/${code}.png"
    if [ -f "$cache_file" ]; then
        echo "$cache_file"; return 0
    fi

    if [ "$trigger" = "true" ] && [ ! -f "${cache_file}.downloading" ]; then
        mkdir -p "$FLAG_CACHE_DIR"
        touch "${cache_file}.downloading"
        (
            local url="${FLAG_URL_BASE}${code}.png"
            if command -v curl >/dev/null 2>&1; then
                curl -s -f -o "$cache_file" "$url" 2>/dev/null || rm -f "$cache_file"
            elif command -v wget >/dev/null 2>&1; then
                wget -q -O "$cache_file" "$url" 2>/dev/null || rm -f "$cache_file"
            fi
            rm -f "${cache_file}.downloading"
        ) &
    fi
    return 1
}

# Get best available flag icon for a VPN name.
# Returns: file path, emoji, or fallback icon name.
# Usage: get_flag_icon VPN_NAME [is_connected=false] [trigger_download=false]
get_flag_icon() {
    local vpn_name="$1" is_connected="${2:-false}" trigger_dl="${3:-false}"
    local fallback=$( [ "$is_connected" = "true" ] && echo "$ICON_CONNECTED" || echo "$ICON_DISCONNECTED" )
    local code; code=$(extract_country_code "$vpn_name") || { echo "$fallback"; return; }

    # 1. Local flag dir
    [ -n "$FLAG_DIR" ] && [ -f "$FLAG_DIR/${code,,}.png" ] && { echo "$FLAG_DIR/${code,,}.png"; return; }

    # 2. Cached remote flag (+ optional async download trigger)
    local cached; cached=$(get_cached_flag "$code" "$trigger_dl") && { echo "$cached"; return; }

    # 3. Emoji flag
    if [ "$USE_EMOJI_FLAGS" = "true" ]; then
        local emoji; emoji=$(country_code_to_flag_emoji "$code") && { echo "$emoji"; return; }
    fi

    echo "$fallback"
}

# Pre-fetch missing flags for all VPNs in the background
prefetch_missing_flags() {
    [ -z "$FLAG_URL_BASE" ] && return
    mkdir -p "$FLAG_CACHE_DIR"
    while IFS= read -r vpn; do
        local code; code=$(extract_country_code "$vpn") && get_cached_flag "$code" "true" >/dev/null
    done <<< "$ALL_VPNS"
}

# Send a dunstify notification.
# Usage: notify TITLE MESSAGE URGENCY ICON TIMEOUT [VPN_NAME]
notify() {
    command -v dunstify >/dev/null 2>&1 || return 0
    local title="$1" msg="$2" urgency="$3" icon="$4" timeout="$5" vpn="${6:-}"

    if [ -n "$vpn" ]; then
        local flag; flag=$(get_flag_icon "$vpn" "false")
        # Use flag only if it's a file path, not an emoji or icon name
        [[ "$flag" =~ ^/ || "$flag" =~ \.(png|svg|jpg|jpeg)$ ]] && icon="$flag"
    fi

    dunstify "$title" "$msg" -r "$NOTIF_ID" -u "$urgency" -i "$icon" -t "$timeout" 2>/dev/null || true
}

notify_load()    { notify "VPN Manager" "$1" "normal"   "network-vpn-acquiring" 0     "${2:-}"; }
notify_success() { notify "VPN Manager" "$1" "low"      "security-high"         5000  "${2:-}"; }
notify_error()   { notify "VPN Error"   "$1" "critical" "dialog-error"          5000  "${2:-}"; command -v dunstify >/dev/null 2>&1 || echo "Error: $1" >&2; }
notify_off()     { notify "VPN Manager" "<span foreground='#FF0000'>$VPN_DISCONNECTED_ICON</span>  VPN Disconnected" "low" "network-vpn-no-route" 3000 "${1:-}"; }

# ==============================================================================
# LOGIC
# ==============================================================================

ACTIVE_VPN=$(nmcli -t -f NAME,TYPE connection show --active | grep ":wireguard" | cut -d: -f1 | head -n1)
ALL_VPNS=$(nmcli -t -f NAME,TYPE connection show | grep ":wireguard" | cut -d: -f1 | sort)

if [ -z "$ALL_VPNS" ]; then
    notify_error "No WireGuard configurations found."
    exit 1
fi

# Pre-fetch flags in background
[ -n "$FLAG_URL_BASE" ] && mkdir -p "$FLAG_CACHE_DIR"
(prefetch_missing_flags >/dev/null 2>&1) &

# Determine mode: direct connection or Rofi menu
if [ -n "$DIRECT_CONNECTION" ]; then
    if ! echo "$ALL_VPNS" | grep -q "^${DIRECT_CONNECTION}$"; then
        notify_error "VPN connection '$DIRECT_CONNECTION' not found."
        exit 1
    fi
    TARGET="$DIRECT_CONNECTION"
else
    # Build Rofi menu
    build_menu_entry() {
        local vpn="$1" connected="$2" icon="$3"
        local status
        if [ "$connected" = "true" ]; then
            status="<span foreground='#00ff00' size='large' weight='bold'>$VPN_CONNECTED_ICON</span>"
        else
            status="" #dont use anything if not connected
            # status="$VPN_DISCONNECTED_ICON"
        fi
        local text="$vpn $status"
        if [[ "$icon" =~ ^/ || "$icon" =~ \.(png|svg|jpg|jpeg)$ ]]; then
            echo "$text\0icon\x1f$icon"
        elif [[ "$icon" != "$ICON_CONNECTED" && "$icon" != "$ICON_DISCONNECTED" ]]; then
            echo "$icon $text\0icon\x1f$icon"
        else
            echo "$text\0icon\x1f$icon"
        fi
    }

    ROFI_LIST=""
    [ -n "$ACTIVE_VPN" ] && ROFI_LIST+="$(build_menu_entry "$ACTIVE_VPN" "true" "$(get_flag_icon "$ACTIVE_VPN" "true")")\n"
    while IFS= read -r vpn; do
        [ "$vpn" = "$ACTIVE_VPN" ] && continue
        ROFI_LIST+="$(build_menu_entry "$vpn" "false" "$(get_flag_icon "$vpn" "false")")\n"
    done <<< "$ALL_VPNS"

    local status_msg="Status:  Unsecured"
    [ -n "$ACTIVE_VPN" ] && status_msg="Status:  Connected to $ACTIVE_VPN"

    SELECTED=$(echo -en "$ROFI_LIST" | rofi -dmenu -i -p "VPN " -mesg "$status_msg" -theme "$ROFI_THEME" -markup-rows)
    [ -z "$SELECTED" ] && exit 0

    # Strip Pango markup, emojis, icons, leading non-alphanumeric chars, and trailing status indicator
    # First remove markup, then remove the connected icon, then clean up whitespace and extract the VPN name
    TARGET=$(echo "$SELECTED" | sed 's/<[^>]*>//g' | sed 's/'"$VPN_CONNECTED_ICON"'//g' | sed 's/^[^[:alnum:]]*//; s/[[:space:]]*$//' | awk '{print $1}')
fi

# Determine action
if [ -n "$ACTIVE_VPN" ] && [ "$TARGET" = "$ACTIVE_VPN" ]; then
    ACTION="disconnect"
else
    ACTION="connect"
fi

# ==============================================================================
# ACTION HANDLER
# ==============================================================================

if [ "$ACTION" = "disconnect" ]; then
    notify_load "Disconnecting..." "$TARGET"
    if nmcli connection down "$TARGET"; then
        notify_off "$TARGET"
    else
        notify_error "Failed to disconnect." "$TARGET"
    fi

elif [ "$ACTION" = "connect" ]; then
    notify_load "Securing Connection..." "$TARGET"
    [ -n "$ACTIVE_VPN" ] && nmcli connection down "$ACTIVE_VPN"
    OUTPUT=$(nmcli connection up "$TARGET" 2>&1)
    if [ $? -eq 0 ] || nmcli -t -f NAME,TYPE connection show --active | grep -q "$TARGET"; then
        notify_success "<span foreground='#00FF00'>$VPN_CONNECTED_ICON</span> Connected to $TARGET" "$TARGET"
    else
        notify_error "Connection Failed: $OUTPUT" "$TARGET"
    fi
fi
