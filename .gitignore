tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/tpm
composer/.config/composer/vendor
others/.local/share/nvim
others/.local/state/nvim
**/.DS_Store
hyprland/.config/hypr/lua/generated/theme.lua
hyprland/.config/hypr/lua/local/machine.lua
hyprland/.config/rofi/colors/wallust.rasi
hyprland/.config/waybar/colors.css
