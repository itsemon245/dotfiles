#!/usr/bin/env python3
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib" / "dotfiles_py"))

from dotfiles_tools.cli import main_with_errors
from dotfiles_tools.desktop import main_readable_window

raise SystemExit(main_with_errors(main_readable_window))
